{
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    // "DOM" is needed only so `e2e/**/*.ts` specs can type `page.evaluate()` callbacks that
    // reference browser globals (`document`, `getComputedStyle`, `HTMLImageElement`) - those
    // callbacks run in the browser under test, never in this Node-side config/scripts code, but
    // `tsc` type-checks the whole file against one `lib` regardless of where a callback executes.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["./src/launcher-core/src/shared/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  }
}
