{
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2023",
    // "DOM" is needed only so `e2e/**/*.ts` specs can type `page.evaluate()` callbacks that
    // reference browser globals (`document`, `getComputedStyle`, `HTMLImageElement`) - those
    // callbacks run in the browser under test, never in this Node-side config/scripts code, but
    // `tsc` type-checks the whole file against one `lib` regardless of where a callback executes.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@shared/*": ["./src/launcher-core/src/shared/*"]
    },

    // The same merged-directory trick `tsconfig.json` documents at length, needed here for the same
    // reason: story 017 D1 puts `scripts/validate.ts` on story 013's `collectRepositoryFindings()`,
    // so this Node-side program now reaches `src/contract/launcher-safe-names.ts` and, through it,
    // mirrored modules whose `./harness`, `./fetch-image` and `../../../lib/renderer-source` imports
    // name launcher files this repository deliberately does not mirror. `rootDirs` lets those three
    // relative imports fall through to the studio-owned stand-ins in `src/mirror-runtime/` without
    // hand-editing the mirror - exactly as the browser program already does. (The runtime arm for a
    // `tsx`-run script is `scripts/mirror-boundary-hooks.ts`; Vite's is `launcherBoundary.ts`.)
    "rootDirs": [
      "./src/launcher-core/src/renderer/src/modules/home",
      "./src/launcher-core/src/main/modules/home/news",
      "./src/launcher-core/src/main/modules/home/images",
      "./src/launcher-core/src/main/lib",
      "./src/mirror-runtime"
    ],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  }
}
